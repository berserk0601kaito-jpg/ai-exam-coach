# ローカル開発用（Anthropic APIキーを直接使用）
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase（Supabase プロジェクトのSettings → APIから取得）
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Vercel本番環境でのみ true に設定（APIキーをサーバー側に隠す）
# VITE_USE_PROXY=true

# Stripe（stripe.com のダッシュボードから取得）
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...  ← クライアント側（公開OK）
# STRIPE_SECRET_KEY=sk_live_...            ← サーバー側のみ（Vercel環境変数に設定）
# STRIPE_WEBHOOK_SECRET=whsec_...          ← Webhookシークレット（Vercel環境変数に設定）
# SUPABASE_SERVICE_ROLE_KEY=eyJ...         ← Supabase service_role key（Vercel環境変数に設定）
